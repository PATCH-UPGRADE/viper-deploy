# Shared VIPER environment for a local Docker run.
#   cp assets/.env.local.example assets/.env

# Image tag to run. Every merge to PATCH-UPGRADE/viper publishes sha-<short-sha>
# alongside latest; pin an exact build here rather than tracking latest.
VIPER_VERSION=sha-d8d5f8a

# Replace with a real sk-ant-... key to run the remediation_deployment_time metric
ANTHROPIC_API_KEY=fake-anthropic-key

DATABASE_URL=postgres://postgres:postgres@postgres:5432/viper

NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=not-for-production-change-me

SMTP_FROM="Viper <noreply@localhost>"
SMTP_HOST=SMTP-host-not-set.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
RESEND_API_KEY=false
RESEND_WEBHOOK_SECRET=false
DOMAIN_WHITELIST=domains-not-set.fake-tld

HELM_URL=helm-url.com
HELM_TOKEN=helm-token
N8N_KEY=n8n-key
N8N_AI_SYNC_URL=n8n-ai-sync-url

INNGEST_DEV=1
INNGEST_BASE_URL=http://inngest:8288
PRISMA_CLIENT_ENGINE_TYPE=binary

BLUEFLOW_API_TOKEN=demo-not-for-production

# Image platforms. docker.io/virtalabsinc/blueflow publishes amd64 only, so Apple
# Silicon runs it under emulation
VIPER_PLATFORM=linux/amd64
BLUEFLOW_PLATFORM=linux/amd64
